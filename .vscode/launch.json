{
    "version": "0.2.0",
    
    "configurations": [



        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "Launch and Debug Standalone Blazor WebAssembly App",
            "type": "blazorwasm",
            "request": "launch",
            "cwd": "${workspaceFolder}/calibre-net"
        },

        {
            "name": "Attach and Debug",
            "type": "blazorwasm",
            "request": "attach",
            "url": "https://localhost:7046/"
          }
    ]
}